{
  "files": {
    "includes": [
      "**",
      "!**/dist",
      "!.cdn-tmp",
      "!.bench-out",
      "!.playwright-mcp",
      "!docs",
      "!site/dist",
      "!**/.astro",
      "!*.png",
      "!**/vendor",
      "!site/public/resolvcharts.global.min.js"
    ]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2
  },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended",
      "correctness": {
        "noUnusedFunctionParameters": "warn"
      }
    }
  }
}
