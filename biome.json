{
  "files": {
    "includes": ["**", "!dist", "!.cdn-tmp", "!.bench-out", "!docs", "!*.png"]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2
  },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended",
      "correctness": {
        "noUnusedFunctionParameters": "warn"
      }
    }
  }
}
