{
  "name": "resolvcharts-solid",
  "version": "0.6.0",
  "description": "SolidJS wrapper for resolvcharts",
  "author": "Resolvo Cloud",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ResolvoCloud/ResolvCharts.git",
    "directory": "solid"
  },
  "license": "Apache-2.0",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "resolvcharts": "workspace:^"
  },
  "peerDependencies": {
    "solid-js": "^1.8.0"
  },
  "devDependencies": {
    "solid-js": "^1.9.0",
    "tsdown": "^0.23.1",
    "typescript": "6.0.3"
  },
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "solid",
    "solidjs",
    "solid-js",
    "solid-charts",
    "chart",
    "charts",
    "graph",
    "graphs",
    "canvas",
    "visualization",
    "dataviz",
    "line-chart",
    "bar-chart",
    "pie-chart",
    "donut-chart",
    "area-chart",
    "scatter",
    "bubble",
    "radar",
    "funnel",
    "candlestick",
    "ohlc",
    "waterfall",
    "sparkline",
    "time-series",
    "realtime",
    "streaming",
    "zoom",
    "pan",
    "lightweight",
    "zero-dependency",
    "typescript",
    "resolvcharts"
  ]
}
