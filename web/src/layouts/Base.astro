---
import "@fontsource/ibm-plex-mono/400.css";
import "@fontsource/ibm-plex-mono/500.css";
import "@fontsource/ibm-plex-mono/600.css";
import "@fontsource/ibm-plex-mono/700.css";
import "../styles/global.css";

interface Props {
  title: string;
  description?: string;
  active?: "overview" | "benchmarks" | "charts";
}
const {
  title,
  description = "ResolvCharts — a minimal, zero-dependency charting library. Benchmarks and demos.",
  active = "overview",
} = Astro.props;
const base = import.meta.env.BASE_URL;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <title>{title}</title>
  </head>
  <body>
    <nav class="nav">
      <div class="nav-inner">
        <a class="brand" href={base}>
          <span>resolv<span class="slash">/</span>charts</span>
          <span class="ver">v0.6.0</span>
        </a>
        <div class="nav-links">
          <a href={base} class={active === "overview" ? "active" : ""}>Overview</a>
          <a href={base + "/benchmarks"} class={active === "benchmarks" ? "active" : ""}>Benchmarks</a>
          <a href={base + "/charts"} class={active === "charts" ? "active" : ""}>Chart types</a>
          <a href="https://github.com/ResolvoCloud/ResolvCharts" target="_blank" rel="noopener">GitHub ↗</a>
        </div>
      </div>
    </nav>
    <slot />
    <footer>
      <div class="wrap foot-inner">
        <span>resolv/charts — a project by <a href="https://resolvocloud.com">Resolvo Cloud</a></span>
        <span>apache-2.0 · zero dependencies</span>
        <span class="right">measured on this machine, in this browser</span>
      </div>
    </footer>
  </body>
</html>
