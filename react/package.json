{
  "name": "resolvcharts-react",
  "version": "0.4.1",
  "description": "React wrapper for resolvcharts",
  "author": "Resolvo Cloud",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ResolvoCloud/ResolvCharts.git",
    "directory": "react"
  },
  "license": "Apache-2.0",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "resolvcharts": "workspace:^"
  },
  "peerDependencies": {
    "react": "^18.0.0 || ^19.0.0"
  },
  "devDependencies": {
    "@types/react": "^19.0.0",
    "react": "^19.0.0",
    "tsdown": "^0.23.1",
    "typescript": "6.0.3"
  },
  "publishConfig": {
    "access": "public"
  }
}
