{
  "name": "resolvcharts",
  "version": "0.1.0",
  "description": "A minimal, zero-dependency canvas charting library",
  "author": "Resolvo Cloud",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ResolvoCloud/ResolvCharts.git"
  },
  "bugs": "https://github.com/ResolvoCloud/ResolvCharts/issues",
  "homepage": "https://github.com/ResolvoCloud/ResolvCharts",
  "keywords": [
    "charts",
    "canvas",
    "visualization",
    "graphs",
    "plotting",
    "minimal",
    "realtime",
    "streaming",
    "candlestick",
    "waterfall",
    "sparkline"
  ],
  "license": "Apache-2.0",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "unpkg": "./dist/resolvcharts.global.min.js",
  "jsdelivr": "./dist/resolvcharts.global.min.js",
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=24"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "dev": "tsdown --watch",
    "build": "tsdown && tsdown --format iife --minify --global-name ResolvCharts -d .cdn-tmp && mv .cdn-tmp/index.iife.js dist/resolvcharts.global.min.js && mv .cdn-tmp/index.iife.js.map dist/resolvcharts.global.min.js.map && rm -rf .cdn-tmp",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "bench": "tsdown bench/perf.ts -d .bench-out --format esm --no-dts --external jsdom && node .bench-out/perf.mjs",
    "lint": "biome check .",
    "check:package": "publint && attw --pack . --profile node16",
    "changeset": "changeset",
    "prepack": "pnpm run build",
    "prepublishOnly": "pnpm run typecheck && pnpm run test && pnpm run check:package",
    "docs:api": "typedoc"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@biomejs/biome": "^2.5.15",
    "@changesets/cli": "^3.0.3",
    "jsdom": "^30.1.3",
    "publint": "^0.3.25",
    "tsdown": "^0.23.1",
    "typedoc": "^0.28.20",
    "typescript": "6.0.3",
    "vitest": "^5.0.5",
    "vitest-canvas-mock": "^1.2.0"
  },
  "packageManager": "pnpm@12.14.0"
}
